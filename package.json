{
  "name": "macuxi-fdv",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=24.7" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint lint:tests --continue && pnpm fronteiras",
    "typecheck": "turbo run typecheck typecheck:tests --continue",
    "test": "turbo run test test:tests --continue",
    "lint:tests": "eslint tests --ignore-pattern \"tests/fixtures/**\"",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "test:tests": "vitest run --config tests/vitest.config.ts",
    "test:e2e": "playwright test -c playwright.config.ts",
    "fronteiras": "node scripts/fronteiras.mjs",
    "timers": "node scripts/ci/timers-sync.mjs",
    "contar-testes": "node scripts/contar-testes.mjs",
    "redundancia:codigo": "jscpd --config .jscpd.json apps modules packages scripts db tests",
    "redundancia:mortos": "knip --no-exit-code",
    "format": "prettier --write .",
    "db:subir": "pnpm --filter @macuxi/db banco subir",
    "db:derrubar": "pnpm --filter @macuxi/db banco derrubar",
    "db:migrar": "pnpm --filter @macuxi/db migrar",
    "tenant:criar": "pnpm --filter api tenant criar",
    "super-admin": "pnpm --filter api super-admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@macuxi/config": "workspace:*",
    "@playwright/test": "~1.56.1",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jscpd": "5.4.2",
    "knip": "6.44.2",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
