{
  "name": "@macuxi/conector",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.7" },
  "description": "Conector on-premise do Hub de Integração: lê o ERP do cliente e empurra os dados ao Hub por delta (T-0013).",
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "node scripts/empacotar.mjs",
    "pacote": "node scripts/pacote.mjs",
    "lint": "eslint src test scripts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@macuxi/integracao": "workspace:*",
    "mssql": "^12.7.13",
    "oracledb": "^26.0.0",
    "pg": "8.23.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@macuxi/config": "workspace:*",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.5",
    "@types/oracledb": "^26.0.1",
    "@types/pg": "8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
