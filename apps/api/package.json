{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bootstrap Fastify do monólito modular: monta as rotas dos módulos efetivos com licença, perfil e carteira checados por requisição (T-0004).",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/servidor.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "start": "tsx src/servidor.ts",
    "worker": "tsx src/worker.ts",
    "tenant": "tsx src/cli/tenant.ts",
    "super-admin": "tsx src/cli/super-admin.ts",
    "publicar-pacote": "tsx src/cli/publicar-pacote.ts",
    "uf-do-cnpj": "tsx src/cli/uf-do-cnpj.ts",
    "tenant:codigo-licenca": "tsx src/cli/codigo-licenca.ts",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@macuxi/catalogo": "workspace:*",
    "@macuxi/comum": "workspace:*",
    "@macuxi/core": "workspace:*",
    "@macuxi/db": "workspace:*",
    "@macuxi/gestor": "workspace:*",
    "@macuxi/integracao": "workspace:*",
    "@macuxi/pesquisa": "workspace:*",
    "@macuxi/platform-sdk": "workspace:*",
    "@macuxi/promotor": "workspace:*",
    "@macuxi/treinamento": "workspace:*",
    "@macuxi/vendedor": "workspace:*",
    "fastify": "^5.6.0",
    "image-in-browser": "3.7.0",
    "jpeg-js": "0.4.4",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@macuxi/config": "workspace:*",
    "@types/node": "^22.18.0",
    "@types/pg": "8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
