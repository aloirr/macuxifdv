diff --git a/.github/workflows/apk-publicar.yml b/.github/workflows/apk-publicar.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/apk-publicar.yml
@@ -0,0 +1,62 @@
+name: apk — publicar
+
+# T-0109 (opcional). Baixa o APK de um build do EAS já TERMINADO, salva como <Campo-Demo-vX.Y.Z>.apk e publica no
+# bucket PRIVADO (compatível com S3; Magalu Cloud Object Storage, ADR 0020) com link temporário (até 7 dias).
+# Mesmo script do PC: apps/mobile/scripts/eas/baixar-apk.mjs (só Node puro; sem pnpm install).
+# Manual: Actions → "apk — publicar" → Run workflow. O link sai no resumo do run (repositório privado; vence sozinho).
+# Segredos (environment APK_BUCKET): EXPO_TOKEN (token de robô da Expo, só leitura de builds) e MACUXI_APK_S3_ENDPOINT,
+# MACUXI_APK_S3_REGIAO, MACUXI_APK_S3_BUCKET, MACUXI_APK_S3_CHAVE, MACUXI_APK_S3_SEGREDO. Nenhum vai para a linha de
+# comando nem para o log.
+
+on:
+  workflow_dispatch:
+    inputs:
+      variante:
+        description: 'campo, gestao ou ambos'
+        type: choice
+        options: [campo, gestao, ambos]
+        default: campo
+      canal:
+        description: 'demo (perfis *-preview) ou oficial (perfis *-producao)'
+        type: choice
+        options: [demo, oficial]
+        default: demo
+      validade_horas:
+        description: 'validade do link (1 a 168 horas)'
+        type: string
+        default: '72'
+
+permissions:
+  contents: read
+
+jobs:
+  publicar:
+    name: APK no bucket privado
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    environment: APK_BUCKET
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version-file: .nvmrc
+
+      - name: eas-cli
+        run: npm i -g eas-cli
+
+      - name: baixar e publicar
+        working-directory: apps/mobile
+        env:
+          EXPO_TOKEN: ${{ secrets.EXPO_TOKEN }}
+          MACUXI_APK_S3_ENDPOINT: ${{ secrets.MACUXI_APK_S3_ENDPOINT }}
+          MACUXI_APK_S3_REGIAO: ${{ secrets.MACUXI_APK_S3_REGIAO }}
+          MACUXI_APK_S3_BUCKET: ${{ secrets.MACUXI_APK_S3_BUCKET }}
+          MACUXI_APK_S3_CHAVE: ${{ secrets.MACUXI_APK_S3_CHAVE }}
+          MACUXI_APK_S3_SEGREDO: ${{ secrets.MACUXI_APK_S3_SEGREDO }}
+          VARIANTE: ${{ inputs.variante }}
+          CANAL: ${{ inputs.canal }}
+          VALIDADE: ${{ inputs.validade_horas }}
+        run: |
+          node scripts/eas/baixar-apk.mjs "$VARIANTE" "$CANAL" --publicar --validade-horas "$VALIDADE" | tee saida.txt
+          { echo '### APK publicado'; echo; echo '```'; grep -E '▶|publicado em|link temporário|https://' saida.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
