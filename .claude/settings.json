{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "gerente-projetos",
  "permissions": {
    "allow": [
      "Bash(node scripts/coord.mjs*)",
      "Bash(pnpm install)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm dev*)",
      "Bash(pnpm seed*)",
      "Bash(pnpm exec drizzle-kit generate*)",
      "Bash(pnpm exec playwright test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(git push*)",
      "Bash(pnpm exec drizzle-kit push*)"
    ],
    "additionalDirectories": [
      "C:/Users/domon/dev/forca-vendas"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guarda-donos.mjs"
          }
        ]
      }
    ]
  }
}
