+  `---\nid: ${id}\nde: ${de}\npara: [${para}]\ncc: []\ntipo: ${tipo}\nprioridade: normal\ntarefa: T-0143\nresponde_a: ${respondeA}\nencerra: ${encerra}\ncontrato: null\ncriado_em: 2026-11-09T10:00:00-04:00\n---\n# ${titulo}\n\ncorpo\n`;
