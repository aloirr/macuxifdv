{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "transit": { "dependsOn": ["^transit"] },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["transit"] },
    "typecheck": { "dependsOn": ["transit"] },
    "test": { "dependsOn": ["transit"], "outputs": [], "env": ["MACUXI_PG_*"] },

    "@macuxi/db#lint": { "dependsOn": ["transit"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/**/node_modules/**"] },
    "@macuxi/db#typecheck": { "dependsOn": ["transit"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/**/node_modules/**"] },
    "@macuxi/db#test": { "cache": false, "env": ["MACUXI_PG_*"], "passThroughEnv": ["DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG"] },
    "api#test": { "cache": false, "env": ["MACUXI_PG_*"], "passThroughEnv": ["DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG"] },

    "mobile#lint": { "dependsOn": ["transit"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/**/node_modules/**"] },
    "mobile#typecheck": { "dependsOn": ["transit"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/**/node_modules/**"] },
    "mobile#test": { "dependsOn": ["transit"], "outputs": [], "env": ["MACUXI_PG_*"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/**/node_modules/**"] },

    "mock-api#lint": { "dependsOn": ["transit"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/**/node_modules/**"] },
    "mock-api#typecheck": { "dependsOn": ["transit"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/**/node_modules/**"] },
    "mock-api#test": { "dependsOn": ["transit"], "outputs": [], "env": ["MACUXI_PG_*"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "!$TURBO_ROOT$/**/node_modules/**"] },

    "@macuxi/integracao#test": { "dependsOn": ["transit"], "outputs": [], "env": ["MACUXI_PG_*"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/modulos/**"] },

    "//#lint:tests": {
      "inputs": ["tests/**", "eslint.config.mjs", "$TURBO_ROOT$/apps/**", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "$TURBO_ROOT$/db/**", "!**/node_modules/**", "!**/.next/**", "!**/.expo/**", "!**/.turbo/**", "!**/dist/**"]
    },
    "//#typecheck:tests": {
      "inputs": ["tests/**", "$TURBO_ROOT$/apps/**", "$TURBO_ROOT$/modules/**", "$TURBO_ROOT$/packages/**", "$TURBO_ROOT$/db/**", "!**/node_modules/**", "!**/.next/**", "!**/.expo/**", "!**/.turbo/**", "!**/dist/**"]
    },
    "//#test:tests": { "cache": false, "env": ["MACUXI_FASE_M"] }
  }
}
