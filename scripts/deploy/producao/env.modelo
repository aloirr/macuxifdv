# Modelo dos arquivos de ambiente da produção (T-0086). SÓ NOMES, nenhum valor. Nada disto é preenchido à mão:
#   - os arquivos ficam na VM, em /opt/macuxi, modo 600, dono o usuário de deploy;
#   - os valores vêm dos secrets do environment PRODUCAO (GitHub) ou são gerados na própria VM (openssl rand).
# Quem grava cada arquivo está indicado no cabeçalho de cada bloco.

# ---------- /opt/macuxi/.env — gerado pelo preparar-vm.sh (nunca sai da VM, nunca é regenerado) ----------
MACUXI_PG_APP_SENHA=
MACUXI_PG_WORKER_SENHA=
MACUXI_JWT_SEGREDO=
MACUXI_HUB_CHAVE_PEPPER=
# T-0087/ADR 0029: token do portal (segredo próprio) e chave do segredo TOTP (32 bytes em base64; nunca regenerar). Desde a
# T-0093/ADR 0031 o portal entra só com e-mail e senha: a chave do TOTP fica sem uso (reserva para o TOTP opcional do backlog)
MACUXI_JWT_SEGREDO_PLATAFORMA=
MACUXI_CHAVE_TOTP=

# ---------- /opt/macuxi/portal.env — gerado pelo preparar-vm.sh (T-0091; nunca sai da VM, nunca é regenerado) ----------
# senha do papel macuxi_portal (único com EXECUTE nas plataforma.sa_*); só a api e o passo de papéis (serviço banco) leem
MACUXI_PG_PORTAL_SENHA=

# ---------- /opt/macuxi/banco.env — gravado pelo producao-publicar.yml ----------
# secrets PROD_PG_HOST (IP privado do DBaaS na VPC) e PROD_PG_PORTA (opcional; padrão 5432)
MACUXI_PG_HOST=
MACUXI_PG_PORTA=

# ---------- /opt/macuxi/admin.env — gravado pelo producao-publicar.yml (só os serviços banco, tenant, super-admin e pgcliente leem) ----------
# secrets PROD_PG_ADMIN_USUARIO e PROD_PG_ADMIN_SENHA (o admin criado com o DBaaS macuxi-prod-db)
MACUXI_PG_ADMIN_USUARIO=
MACUXI_PG_ADMIN_SENHA=

# ---------- /opt/macuxi/segredos.env — gravado pelo producao-publicar.yml ----------
# secrets PROD_S3_KEY_ID e PROD_S3_SECRET (chave do Object Storage com acesso ao bucket macuxi-prod)
MACUXI_S3_CHAVE_ID=
MACUXI_S3_SEGREDO=
# (T-0093/ADR 0031: não há mais MACUXI_SUPERADMIN_CONVITE; o super-admin nasce pelo workflow "producao — super-admin", com a
#  senha do secret PROD_SUPERADMIN_SENHA passada ao serviço super-admin só na hora, nunca gravada em arquivo da VM)

# ---------- /opt/macuxi/email.env — gravado pelo producao-publicar.yml (T-0086; só a api e o worker leem) ----------
# T-0094 (ADR 0032; desenho docs/desenho/T-0094-email.md §7): e-mail transacional (1º acesso, nova senha). Cada variável vem do
# secret PROD_<nome sem MACUXI_> (MACUXI_SMTP_HOST ← PROD_SMTP_HOST ...). Sem PROD_SMTP_HOST o arquivo fica vazio e o e-mail,
# desligado (o BKO mostra a senha ao admin; a Equipe por CSV recusa). Com ele, usuário e senha são obrigatórios; porta, TLS e
# remetente são opcionais (padrão 587 com STARTTLS e "Macuxi FDV <nao-responda@macuxifdv.com.br>"). A cifra da outbox deriva
# do MACUXI_JWT_SEGREDO (não há MACUXI_EMAIL_CHAVE).
MACUXI_SMTP_HOST=
MACUXI_SMTP_PORTA=
MACUXI_SMTP_TLS=
MACUXI_SMTP_USUARIO=
MACUXI_SMTP_SENHA=
MACUXI_SMTP_REMETENTE=

# ---------- /opt/macuxi/push.env — gravado pelo producao-publicar.yml (ADR 0053; só o worker lê) ----------
# secrets PROD_FCM_SERVICE_ACCOUNT_JSON (JSON da conta de serviço do Firebase em base64, uma linha) e PROD_FCM_PROJECT_ID.
# Os dois juntos ou nenhum. Sem eles o arquivo fica vazio e o push, desligado (como até a v1.0.9).
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
MACUXI_PUSH_ATIVO=

# ---------- /opt/macuxi/tunel.env — gravado pelo producao-publicar.yml (só o cloudflared lê) ----------
# secret PROD_CLOUDFLARE_TUNNEL_TOKEN (token do túnel macuxi-prod)
TUNNEL_TOKEN=

# ---------- /opt/macuxi/alerta.env — gravado pelo producao-publicar.yml só se o secret existir ----------
# secret PROD_ALERTA_WEBHOOK (opcional: tópico do ntfy.sh ou webhook do Slack/Discord)
MACUXI_ALERTA_WEBHOOK=

# ---------- /opt/macuxi/certs/dbaas-ca.pem — gravado pelo producao-publicar.yml só se o secret existir ----------
# secret PROD_PG_CA_CERT (opcional; PEM da CA do DBaaS). Com ele o TLS vira verify-full.

# ---------- /opt/macuxi/imagens.env — gravado pelo implantar.sh (não é segredo) ----------
MACUXI_IMAGEM_API=
MACUXI_IMAGEM_BKO=
MACUXI_VERSAO=
COMPOSE_PROFILES=
MACUXI_PG_SSL_NODE=
MACUXI_PG_SSL_LIBPQ=
