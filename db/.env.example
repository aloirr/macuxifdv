# Copie para db/.env (ou ponha na .env da raiz). Os valores abaixo são os padrões do Postgres LOCAL
# do db/docker-compose.yml — não são segredo de produção. Nunca versione o .env.
MACUXI_PG_HOST=localhost
MACUXI_PG_PORTA=5432
# administrador: aplica migrações, cria bancos de teste e o papel de aplicação (ignora RLS)
MACUXI_PG_ADMIN_USUARIO=postgres
MACUXI_PG_ADMIN_SENHA=postgres
# banco de desenvolvimento
MACUXI_PG_BANCO=macuxi
# senha do papel de aplicação macuxi_app (LOGIN, sem SUPERUSER, sem BYPASSRLS) — API e testes de RLS
MACUXI_PG_APP_SENHA=macuxi_app_local
# senha do papel macuxi_worker (despacho da outbox, ADR 0007); vazia = papel sem login
MACUXI_PG_WORKER_SENHA=macuxi_worker_local
# senha dos usuários fake da fixture dois-tenants e do seed Fase M (hash argon2id no banco)
MACUXI_SENHA_TESTE=Teste@1234
MACUXI_SENHA_DEMO=demo-macuxi
# 1 = testes de banco FALHAM (em vez de pular) se o Postgres não estiver de pé — use no CI
MACUXI_PG_EXIGIR=0
